{
  "common": {
    "name": "githubsync",
    "version": "0.1.1",
    "title": "GitHub Script Sync",
    "titleLang": {
      "en": "GitHub Script Sync",
      "de": "GitHub Skript-Synchronisierung"
    },
    "desc": {
      "en": "Sync local javascript-adapter scripts with a private GitHub repository",
      "de": "Synchronisiert lokal javascript-adapter Skripte mit einem privaten GitHub-Repository"
    },
    "authors": [
      {
        "name": "HJS72",
        "email": "stefan@spanninger.de"
      }
    ],
    "keywords": [
      "ioBroker",
      "github",
      "sync",
      "scripts",
      "javascript"
    ],
    "homepage": "https://github.com/HJS72/iobroker.githubsync",
    "license": "MIT",
    "platform": "Javascript/Node.js",
    "architecture": [
      "amd64",
      "arm",
      "arm64"
    ],
    "main": "main.js",
    "icon": "admin/githubsync.svg",
    "enabled": true,
    "extIcon": "https://raw.githubusercontent.com/HJS72/iobroker.githubsync/main/admin/githubsync.svg",
    "readme": "https://github.com/HJS72/iobroker.githubsync/blob/main/README.md",
    "loglevel": "info",
    "mode": "daemon",
    "type": "general",
    "compact": false,
    "connectionType": "cloud",
    "dataSource": "push",
    "adminUI": {
      "config": "json"
    },
    "dependencies": [
      {
        "js-controller": ">=5.0.0"
      }
    ],
    "preserveSettings": [
      "objects"
    ],
    "isInstalled": false,
    "news": {
      "NEXT": {
        "en": "see CHANGELOG.md",
        "de": "siehe CHANGELOG.md"
      },
      "0.1.1": {
        "en": "Official-adapter test suite (@iobroker/testing), required io-package.json fields added",
        "de": "Test-Suite fuer offiziellen Adapter (@iobroker/testing), benoetigte io-package.json Felder ergaenzt"
      },
      "0.1.0": {
        "en": "Locally deleted script files are moved to a trash/ folder in the GitHub repo instead of being left orphaned",
        "de": "Lokal geloeschte Skripte werden im GitHub-Repo in einen trash/-Ordner verschoben statt verwaist zu bleiben"
      },
      "0.0.2": {
        "en": "Fixed missing instanceObjects for existing instances",
        "de": "Fehlende instanceObjects fuer bestehende Instanzen behoben"
      },
      "0.0.1": {
        "en": "Initial release",
        "de": "Erste Veroeffentlichung"
      }
    }
  },
  "native": {
    "gitHubUrl": "",
    "gitHubToken": "",
    "localScriptPath": "",
    "syncInterval": 300,
    "autoSync": true,
    "pullBeforePush": true,
    "includePathPattern": "**/*.js,**/*.ts",
    "excludePathPattern": "",
    "trashDeletedFiles": true
  },
  "encryptedNative": ["gitHubToken"],
  "protectedNative": ["gitHubToken"],
  "instanceObjects": [
    {
      "_id": "syncNow",
      "type": "state",
      "common": {
        "name": "Trigger sync now",
        "type": "boolean",
        "role": "button",
        "read": true,
        "write": true,
        "desc": "Set to true to trigger an immediate sync"
      },
      "native": {}
    },
    {
      "_id": "lastSync",
      "type": "state",
      "common": {
        "name": "Last sync timestamp",
        "type": "number",
        "role": "value.time",
        "read": true,
        "write": false,
        "desc": "Timestamp of last successful sync"
      },
      "native": {}
    },
    {
      "_id": "lastError",
      "type": "state",
      "common": {
        "name": "Last error message",
        "type": "string",
        "role": "value",
        "read": true,
        "write": false,
        "desc": "Last error message from sync operation"
      },
      "native": {}
    },
    {
      "_id": "syncStatus",
      "type": "state",
      "common": {
        "name": "Sync status",
        "type": "string",
        "role": "value",
        "read": true,
        "write": false,
        "desc": "Current sync status (idle/syncing/error)"
      },
      "native": {}
    },
    {
      "_id": "syncCount",
      "type": "state",
      "common": {
        "name": "Sync count",
        "type": "number",
        "role": "value.count",
        "read": true,
        "write": false,
        "desc": "Number of files synced in last operation"
      },
      "native": {}
    },
    {
      "_id": "connected",
      "type": "state",
      "common": {
        "name": "Connected to GitHub",
        "type": "boolean",
        "role": "indicator.connected",
        "read": true,
        "write": false,
        "desc": "Connection status to GitHub"
      },
      "native": {}
    }
  ]
}
